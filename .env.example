# Frontend Environment Variables (Vercel)
REACT_APP_BACKEND_URL=https://tu-app-backend.railway.app

# Backend Environment Variables (Railway)
MONGO_URL=mongodb+srv://usuario:password@cluster.mongodb.net/ventas_music_db
PORT=8001

# Database Configuration (MongoDB Atlas)
# Obtén tu connection string de: https://cloud.mongodb.com
# Formato: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>

# File Upload Configuration (Opcional - para almacenamiento en la nube)
# AWS_ACCESS_KEY_ID=tu_access_key
# AWS_SECRET_ACCESS_KEY=tu_secret_key
# AWS_BUCKET_NAME=tu_bucket_name
# AWS_REGION=us-east-1